{
  "name": "@ghuri/auth",
  "version": "0.1.0-alpha.1",
  "description": "Ghuri auth: users, groups, permissions, sessions, tokens, JWT",
  "type": "module",
  "license": "MIT",
  "author": "Ghuri contributors",
  "homepage": "https://github.com/ghurijs/auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghurijs/auth.git"
  },
  "bugs": {
    "url": "https://github.com/ghurijs/auth/issues"
  },
  "keywords": [
    "ghuri",
    "django",
    "cloudflare",
    "workers",
    "hono",
    "drizzle",
    "d1",
    "r2",
    "framework"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "peerDependencies": {
    "@ghuri/core": "^0.1.0-alpha.0",
    "@ghuri/orm": "^0.1.0-alpha.0",
    "@ghuri/rest": "^0.1.0-alpha.0",
    "hono": "^4.13.0"
  },
  "peerDependenciesMeta": {
    "@ghuri/rest": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsup": "^8.5.1",
    "vitest": "^5.1.0",
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.0.0",
    "@ghuri/core": "^0.1.0-alpha.1",
    "@ghuri/orm": "^0.1.0-alpha.0",
    "@ghuri/rest": "^0.1.0-alpha.0",
    "hono": "^4.13.0",
    "drizzle-orm": "^0.45.0",
    "better-sqlite3": "^13.1.0",
    "@electric-sql/pglite": "^0.5.16",
    "miniflare": "^4.20260730.0",
    "esbuild": "^0.27.7"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
